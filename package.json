{
  "name": "ai-task-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port ${PORT:-4224}",
    "dev:web": "next dev --port ${PORT:-4224}",
    "dev:stt": "docker compose -f modules/parakeet-stt/docker-compose.yml up parakeet-cpu",
    "build": "next build",
    "start": "next start",
    "ts": "tsc --noEmit",
    "lint": "eslint",
    "db:seed": "tsx dev-seed/seed.ts",
    "db:reset": "tsx dev-seed/reset-and-seed.ts",
    "db:triage": "rm -f dev-seed/raw/triage.json && tsx dev-seed/triage.ts",
    "db:triage:claude": "rm -f dev-seed/raw/triage.json && tsx dev-seed/triage.ts --provider claude",
    "db:triage:codex": "rm -f dev-seed/raw/triage.json && tsx dev-seed/triage.ts --provider codex",
    "dev:seed-ui": "tsx dev-seed/serve.ts",
    "dev:seed-ui:kill": "lsof -ti :3333 | xargs kill -9 2>/dev/null || true",
    "db:embed": "dotenv -e .env.local -- tsx src/lib/embeddings/backfill.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "auth:pair": "tsx scripts/pair.ts",
    "cli:dev": "tsx src/cli/index.ts",
    "cli:build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "bin": {
    "flow": "./dist/cli/index.mjs"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@agentex/agent": "^0.0.2",
    "@ai-sdk/anthropic": "^3.0.63",
    "@ai-sdk/openai": "^3.0.48",
    "@ai-sdk/react": "^3.0.136",
    "@anthropic-ai/sdk": "^0.78.0",
    "@base-ui/react": "^1.2.0",
    "@clack/prompts": "^1.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@google/generative-ai": "^0.24.1",
    "@mastra/core": "^1.9.0",
    "@sindresorhus/slugify": "^3.0.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-virtual": "^3.13.23",
    "@tiptap/core": "^3.21.0",
    "@tiptap/extension-bubble-menu": "^3.21.0",
    "@tiptap/extension-character-count": "^3.21.0",
    "@tiptap/extension-code-block-lowlight": "^3.21.0",
    "@tiptap/extension-floating-menu": "^3.21.0",
    "@tiptap/extension-highlight": "^3.21.0",
    "@tiptap/extension-image": "^3.21.0",
    "@tiptap/extension-link": "^3.21.0",
    "@tiptap/extension-placeholder": "^3.21.0",
    "@tiptap/extension-task-item": "^3.21.0",
    "@tiptap/extension-task-list": "^3.21.0",
    "@tiptap/extension-typography": "^3.21.0",
    "@tiptap/extension-underline": "^3.21.0",
    "@tiptap/markdown": "^3.21.0",
    "@tiptap/pm": "^3.21.0",
    "@tiptap/react": "^3.21.0",
    "@tiptap/starter-kit": "^3.21.0",
    "@tiptap/suggestion": "^3.21.0",
    "ai": "^6.0.134",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "commander": "^14.0.3",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "emoji-mart": "^5.6.0",
    "fractional-indexing": "^3.2.0",
    "get-port": "^7.2.0",
    "googleapis": "^171.4.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.575.0",
    "motion": "^12.38.0",
    "nanoid": "^5.1.9",
    "next": "16.1.6",
    "open": "^11.0.0",
    "openai": "^6.26.0",
    "picocolors": "^1.1.1",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shadcn": "^3.8.5",
    "sqlite-vec": "^0.1.7",
    "sqlite-vec-darwin-arm64": "^0.1.7",
    "streamdown": "^2.5.0",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.3",
    "uuidv7": "^1.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
