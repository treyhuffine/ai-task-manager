{
  "name": "ai-task-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:stt": "docker compose -f modules/parakeet-stt/docker-compose.yml up parakeet-cpu",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "tsx dev-seed/seed.ts",
    "db:reset": "tsx dev-seed/reset-and-seed.ts",
    "db:triage": "rm -f dev-seed/raw/triage.json && tsx dev-seed/triage.ts",
    "db:triage:claude": "rm -f dev-seed/raw/triage.json && tsx dev-seed/triage.ts --provider claude",
    "db:triage:codex": "rm -f dev-seed/raw/triage.json && tsx dev-seed/triage.ts --provider codex",
    "dev:seed-ui": "tsx dev-seed/serve.ts",
    "dev:seed-ui:kill": "lsof -ti :3333 | xargs kill -9 2>/dev/null || true"
  },
  "dependencies": {
    "@agentex/agent": "^0.0.2",
    "@ai-sdk/anthropic": "^3.0.63",
    "@ai-sdk/openai": "^3.0.48",
    "@ai-sdk/react": "^3.0.136",
    "@anthropic-ai/sdk": "^0.78.0",
    "@base-ui/react": "^1.2.0",
    "@google/generative-ai": "^0.24.1",
    "@mastra/core": "^1.9.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-query": "^5.95.2",
    "ai": "^6.0.134",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "fractional-indexing": "^3.2.0",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "openai": "^6.26.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shadcn": "^3.8.5",
    "streamdown": "^2.5.0",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.3",
    "uuidv7": "^1.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
