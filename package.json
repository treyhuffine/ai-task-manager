{
  "name": "ai-task-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/fetch-symbols-icons.mjs",
    "dev": "FLOW_ROOT=${FLOW_ROOT:-$HOME/flow-dev} next dev --port ${PORT:-4224}",
    "dev:hot": "NEXT_PUBLIC_HOT=1 FLOW_ROOT=${FLOW_ROOT:-$HOME/flow-dev} next dev --port ${PORT:-4224}",
    "dev:web": "FLOW_ROOT=${FLOW_ROOT:-$HOME/flow-dev} next dev --port ${PORT:-4224}",
    "dev:stt": "docker compose -f modules/parakeet-stt/docker-compose.yml up parakeet-cpu",
    "build": "next build",
    "start": "next start",
    "ts": "tsc --noEmit",
    "lint": "eslint",
    "db:seed": "tsx personal/notion-import/seed.ts",
    "db:reset": "tsx personal/notion-import/reset-and-seed.ts",
    "db:triage": "rm -f personal/notion-import/raw/triage.json && tsx personal/notion-import/triage.ts",
    "db:triage:claude": "rm -f personal/notion-import/raw/triage.json && tsx personal/notion-import/triage.ts --provider claude",
    "db:triage:codex": "rm -f personal/notion-import/raw/triage.json && tsx personal/notion-import/triage.ts --provider codex",
    "db:retriage": "tsx scripts/triage/retriage.ts",
    "db:retriage:claude": "tsx scripts/triage/retriage.ts --provider claude",
    "db:retriage:plan": "tsx scripts/triage/apply.ts",
    "db:retriage:apply": "tsx scripts/triage/apply.ts --apply",
    "dev:seed-ui": "tsx personal/notion-import/serve.ts",
    "dev:seed-ui:kill": "lsof -ti :3333 | xargs kill -9 2>/dev/null || true",
    "db:embed": "dotenv -e .env.local -- tsx src/lib/embeddings/backfill.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "auth:pair": "tsx scripts/pair.ts",
    "cli:dev": "tsx src/cli/index.ts",
    "cli:build": "tsup",
    "smoke": "tsx scripts/smoke-orchestrator.ts",
    "smoke:agent": "tsx scripts/smoke-orchestrator-agent.ts",
    "smoke:harness": "tsx scripts/smoke-orchestrator-harness.ts",
    "smoke:boot": "tsx src/cli/index.ts start --help > /dev/null && echo 'cli boot graph resolves'",
    "migrate:layout": "tsx scripts/migrate-layout.ts",
    "dev:reset": "tsx scripts/seed-dev/reset.ts",
    "dev:seed": "tsx scripts/seed-dev/seed.ts",
    "dev:reseed": "tsx scripts/seed-dev/reseed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "bin": {
    "flow": "./dist/cli/index.mjs"
  },
  "files": [
    "dist",
    "skills"
  ],
  "dependencies": {
    "@agentex/agent": "^0.0.21",
    "@agentex/github": "^0.0.1",
    "@agentex/workspace": "^0.0.4",
