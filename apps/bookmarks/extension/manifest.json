{
  "manifest_version": 3,
  "name": "Ri Bookmarks",
  "version": "0.1.0",
  "description": "Save links to your own Ri. Keeps your normal bookmarks in step and saves the text of the page you are reading.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save this page to Ri",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["activeTab", "alarms", "bookmarks", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Save this page to Ri" }
  },
  "minimum_chrome_version": "120"
}
