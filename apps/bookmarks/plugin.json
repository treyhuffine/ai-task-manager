{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "ri-bookmarks",
  "version": "0.1.0",
  "description": "Save links from anywhere and find them again by what the page said.",
  "license": "UNLICENSED",
  "extensions": {
    "com.ri": {
      "formatVersion": 1,
      "displayName": "Bookmarks",
      "icon": "bookmark",
      "hostApi": 1,
      "suggestedSlug": "bookmarks",
      "runtime": {
        "kind": "node",
        "protocol": "ri-ipc-v1",
        "entry": "dist/server.mjs",
        "start": "on-demand",
        "executionProfile": "trusted-native",
        "access": "ri-access-v1"
      },
      "build": {
        "adapter": "ri-esbuild-v1",
        "lockfile": "pnpm-lock.yaml",
        "executionProfile": "trusted-native"
      },
      "ui": {
        "resources": [
          {
            "uri": "ui://ri-bookmarks/main.html",
            "file": "dist/ui.html"
          }
        ],
        "entrypoints": [
          "global",
          "thread"
        ],
        "resolveAction": "open_view",
        "contextAction": "describe_view_context",
        "access": {
          "path": "/access",
          "action": "create_scope"
        }
      },
      "contract": "contract.json",
      "requests": {
        "integrations": [],
        "riActions": [
          "read_web_page"
        ],
        "clientActions": [
          "save_bookmarks",
          "save_link",
          "describe_connection"
        ],
        "files": {
          "select": {
            "mimeTypes": [
              "text/html",
              "text/csv",
              "text/plain"
            ],
            "maxBytes": 33554432
          },
          "download": {
            "mimeTypes": [
              "application/zip",
              "text/html"
            ],
            "maxBytes": 8388608
          }
        }
      },
      "source": {
        "kind": "starter",
        "version": "0.1.0"
      }
    }
  }
}
