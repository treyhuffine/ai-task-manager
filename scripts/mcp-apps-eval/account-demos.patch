+import { Client } from '@modelcontextprotocol/client';
+
+type Transport = Parameters<Client['connect']>[0];
+type Message = Parameters<NonNullable<Transport['onmessage']>>[0];
+
+/** An authenticated parent operates Ri's existing runtime. This iframe has no credential. */
+export async function connectAccount(handle: string): Promise<Client> {
+  const origin = document.documentElement.dataset.evaluationParentOrigin;
+  if (!origin || !/^[a-f0-9-]{36}$/i.test(handle)) throw new Error('Account view has no authenticated parent');
+  const pending = new Map<string | number, number>();
+  const channel = crypto.randomUUID();
+  const transport: Transport = {
+    onmessage: undefined, onclose: undefined, onerror: undefined,
+    async start() { window.addEventListener('message', receive); },
+    async send(message) {
+      if (!('id' in message) || message.id === undefined || !('method' in message)) return;
+      const id = message.id;
+      const timer = window.setTimeout(() => {
+        pending.delete(id);
+        transport.onmessage?.({ jsonrpc: '2.0', id, error: { code: -32000, message: 'Account request timed out. No call was repeated.' } });
+      }, 120000);
+      pending.set(id, timer);
+      window.parent.postMessage({ kind: 'ri-account-rpc', handle, channel, rpc: { id, method: message.method, ...('params' in message ? { params: message.params } : {}) } }, origin);
+    },
+    async close() {
+      window.removeEventListener('message', receive);
+      for (const timer of pending.values()) window.clearTimeout(timer);
+      pending.clear();
+      transport.onclose?.();
+    },
+  };
+  function receive(event: MessageEvent) {
+    if (event.source !== window.parent || event.origin !== origin || event.data?.kind !== 'ri-account-response' || event.data.handle !== handle || event.data.channel !== channel) return;
+    const rpc = event.data.rpc;
+    if (!rpc || !pending.has(rpc.id)) return;
+    window.clearTimeout(pending.get(rpc.id)); pending.delete(rpc.id);
+    transport.onmessage?.(rpc as Message);
+  }
+  const client = new Client({ name: 'Ri interactive evaluation', version: '1.0.0' }, {
+    capabilities: { extensions: { 'io.modelcontextprotocol/ui': { mimeTypes: ['text/html;profile=mcp-app'] } } },
+  });
+  await client.connect(transport);
+  return client;
+}
