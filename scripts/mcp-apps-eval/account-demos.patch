+import { use, useState } from 'react';
+import { getToolUiResourceUri } from '@modelcontextprotocol/ext-apps/app-bridge';
+import type { Tool } from '@modelcontextprotocol/client';
+import { callTool, type ServerInfo, type ToolCallInfo } from './implementation';
+
+type Schema = { type?: string; default?: unknown; const?: unknown; enum?: unknown[]; properties?: Record<string, Schema>; required?: string[]; anyOf?: Schema[]; oneOf?: Schema[]; description?: string };
+const SQL = "SELECT toDate(timestamp) AS day, count() AS pageviews FROM events WHERE event = '$pageview' AND timestamp > now() - INTERVAL 7 DAY GROUP BY day ORDER BY day";
+function schemaFor(value: Schema): Schema {
+  const variants = value.anyOf ?? value.oneOf;
+  return variants?.find(value => value.properties?.kind?.const === 'HogQLQuery' || value.properties?.kind?.enum?.includes('HogQLQuery'))
+    ?? variants?.find(value => value.type !== 'null') ?? value;
+}
+function defaults(raw: Schema, key = ''): unknown {
+  const schema = schemaFor(raw);
+  if (schema.default !== undefined) return schema.default;
+  if (schema.const !== undefined) return schema.const;
+  if (schema.enum?.length) return schema.enum[0];
+  if (schema.properties) return Object.fromEntries(Object.entries(schema.properties).flatMap(([key, child]) => {
+    const value = defaults(child, key);
+    return value === undefined ? [] : [[key, value]];
+  }));
+  if (/mermaid/i.test(key)) return 'graph TD\n  A[Capture] --> B[Review]\n  B --> C[Act]';
+  if (/^(name|title)$/i.test(key)) return 'Ri interactive preview';
+  if (/^(query|sql)$/i.test(key) && schema.type === 'string') return SQL;
+  return undefined;
+}
+function Fields({ schema: raw, value, change, path = '' }: { schema: Schema; value: Record<string, unknown>; change: (value: Record<string, unknown>) => void; path?: string }) {
+  const schema = schemaFor(raw);
+  return <>{Object.entries(schema.properties ?? {}).slice(0, 24).map(([key, raw]) => {
+    const field = schemaFor(raw);
+    const label = key.replaceAll('_', ' ').replace(/([a-z])([A-Z])/g, '$1 $2');
+    const id = `${path}${key}`;
+    const update = (next: unknown) => change({ ...value, [key]: next });
+    if (field.properties && path.split('.').length < 4) return <fieldset key={key}><legend>{label}</legend><Fields schema={field} value={(value[key] as Record<string, unknown>) ?? {}} change={update} path={`${id}.`} /></fieldset>;
+    if (field.const !== undefined) return null;
+    if (field.enum) return <label key={key}>{label}<select aria-label={id} value={String(value[key] ?? '')} onChange={event => update(event.target.value)}><option value="">Choose</option>{field.enum.map(option => <option key={String(option)}>{String(option)}</option>)}</select></label>;
+    if (field.type === 'boolean') return <label key={key}><input aria-label={id} type="checkbox" checked={value[key] === true} onChange={event => update(event.target.checked)} />{label}</label>;
+    if (field.type === 'number' || field.type === 'integer') return <label key={key}>{label}<input aria-label={id} type="number" value={value[key] === undefined ? '' : String(value[key])} onChange={event => update(event.target.value === '' ? undefined : Number(event.target.value))} /></label>;
+    if (field.type === 'string' || !field.type && !field.properties) return <label key={key}>{label}{/query|sql|description|mermaid/i.test(key)
+      ? <textarea aria-label={id} rows={4} value={String(value[key] ?? '')} onChange={event => update(event.target.value || undefined)} />
+      : <input aria-label={id} value={String(value[key] ?? '')} onChange={event => update(event.target.value || undefined)} />}</label>;
+    return <details key={key}><summary>{label}, advanced input</summary><textarea aria-label={id} rows={3} defaultValue={value[key] === undefined ? '' : JSON.stringify(value[key], null, 2)} onBlur={event => { try { update(event.target.value ? JSON.parse(event.target.value) : undefined); } catch { event.target.setCustomValidity('Enter valid JSON for this advanced field.'); } }} /></details>;
+  })}</>;
+}
+function AccountTool({ server, tool, addToolCall, activeCount }: { server: ServerInfo; tool: Tool; addToolCall: (info: ToolCallInfo) => void; activeCount: number }) {
+  const [input, setInput] = useState<Record<string, unknown>>(() => (defaults(tool.inputSchema as Schema) as Record<string, unknown>) ?? {});
+  const [error, setError] = useState<string | null>(null);
+  function run() { setError(null); try { addToolCall(callTool(server, tool.name, input)); } catch { setError('The view could not start. No call was repeated.'); } }
+  return <form onSubmit={event => { event.preventDefault(); run(); }}>
+    <p>{tool.description?.slice(0, 500)}</p>
+    <div style={{ display: 'grid', gap: '12px', maxWidth: '720px' }}><Fields schema={tool.inputSchema as Schema} value={input} change={setInput} /></div>
+    <p><button type="button" onClick={run} disabled={activeCount >= 4}>Run and show result</button></p>
+    <p>This is a new call on the selected account. Any required approval appears in Ri before the call runs.</p>
+    {error && <p role="alert">{error}</p>}
+  </form>;
+}
+export function AccountPresets({ serversPromise, addToolCall, activeCount }: { serversPromise: Promise<ServerInfo[]>; addToolCall: (info: ToolCallInfo) => void; activeCount: number }) {
+  const servers = use(serversPromise);
+  const server = servers[0];
+  const tools = server ? [...server.tools.values()].filter(tool => getToolUiResourceUri(tool) && (!tool._meta?.ui || !Array.isArray((tool._meta.ui as { visibility?: unknown }).visibility) || (tool._meta.ui as { visibility: string[] }).visibility.includes('model')))
+    .sort((a, b) => Number(!/search_tasks_preview|query.run|query.trends|generate_diagram/.test(a.name)) - Number(!/search_tasks_preview|query.run|query.trends|generate_diagram/.test(b.name))) : [];
+  const [selected, setSelected] = useState('');
+  const tool = tools.find(tool => tool.name === selected) ?? tools[0];
+  if (!server) return <section><p role="alert">This account could not connect. Return to Plugins to check its setup.</p></section>;
+  return <section style={{ padding: '24px' }} aria-label="Selected account interactive tools">
+    <h2>{server.name}</h2>
+    {!tool ? <p role="status">No compatible interactive tool was discovered. The account remains available for ordinary tools in Ri.</p> : <>
+      <label>Interactive workflow <select aria-label="Interactive workflow" value={tool.name} onChange={event => setSelected(event.target.value)}>{tools.map(tool => <option key={tool.name} value={tool.name}>{tool.title ?? tool.name}</option>)}</select></label>
+      <AccountTool key={tool.name} server={server} tool={tool} addToolCall={addToolCall} activeCount={activeCount} />
+    </>}
+  </section>;
+}
