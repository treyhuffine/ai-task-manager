# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# DO NOT REMOVE — `/personal/` is a per-user scratch zone for data, scripts, and tools
# that are unique to whoever is working in this repo (data importers, private notes,
# local experiments). Anything in here is intentionally outside the public repo.
# Removing this line risks leaking personal content into git history.
/personal/

# dependencies at any directory depth
node_modules/
/.pnpm-store/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# AI
.claude/projects
code-archive
.claude/settings.local.json
.spec-workflow
/examples

# testing
/coverage

# next.js
/.next/
/.next-verify/
/.next-ws-dev/
/.next-smoke/
/.next-bundle-audit/
/.next-desktop/
/.next-desktop-dev/
# Any other Next build folder (NEXT_DIST_DIR=.next-<name> for a second dev
# server). Tailwind scans every file git doesn't ignore, and a build cache's
# binary files turn into garbage classes that break every dev server's CSS.
/.next-*/
/.electron-demo/
/out/
.turbo

# production
/build

# CLI bundle — build artifact, regenerated by `prepare` (tsup) on install. Never commit.
/dist/

# misc
.DS_Store
*.pem

# local sqlite stubs (real db lives in ~/.<app>/ — see src/lib/config/paths.ts)
*.db
*.db-shm
*.db-wal
*.db.bak

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel
/.next-plugin-ready/

# typescript
*.tsbuildinfo
# Custom NEXT_DIST_DIR builds get their own generated route configuration.
/tsconfig.next-*.json*
next-env.d.ts
.reference/

# Vendored from miguelsolorio/vscode-symbols via scripts/fetch-symbols-icons.mjs
/public/symbols-icons/
.gstack/

# Packaged desktop artifacts
/release/

# Local source-mentions delivery and qualification artifacts
/.work/chat-sources/
