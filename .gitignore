# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# DO NOT REMOVE — `/personal/` is a per-user scratch zone for data, scripts, and tools
# that are unique to whoever is working in this repo (data importers, private notes,
# local experiments). Anything in here is intentionally outside the public repo.
# Removing this line risks leaking personal content into git history.
/personal/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# AI
.claude/projects
code-archive
.claude/settings.local.json
.spec-workflow
/examples

# testing
/coverage

# next.js
/.next/
/.next-smoke/
/out/
.turbo

# production
/build

# misc
.DS_Store
*.pem

# local sqlite stubs (real db lives in ~/.<app>/ — see src/lib/config/paths.ts)
*.db
*.db-shm
*.db-wal
*.db.bak

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.reference/
